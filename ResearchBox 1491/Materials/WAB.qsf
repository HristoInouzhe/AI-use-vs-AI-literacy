ess?","Choices":{"1":{"Display":"Data collection"},"2":{"Display":"Model selection"},"3":{"Display":"Prediction"},"4":{"Display":"Model evaluation"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"1","2":"0","3":"0","4":"0"},"GradingData":[{"ChoiceID":"1","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1112","VariableNaming":{"1":"Data collection","2":"Model selection","3":"Prediction","4":"Model evaluation"}}},{"SurveyID":"SV_bqgf48GueBCVgDI","Element":"SQ","PrimaryAttribute":"QID1118","SecondaryAttribute":"Which of the following is an example of metadata?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which of the following is an example of metadata?","DefaultChoices":false,"DataExportTag":"11","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which of the following is an example of metadata?","Choices":{"1":{"Display":"A spreadsheet of numbers"},"2":{"Display":"Column headers in a table"},"3":{"Display":"A chart visualization"},"4":{"Display":"Raw sensor data"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"1","3":"0","4":"0"},"GradingData":[{"ChoiceID":"2","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1118","VariableNaming":{"1":"A spreadsheet of numbers","2":"Column headers in a table","3":"A chart visualization","4":"Raw sensor data"}}},{"SurveyID":"SV_bqgf48GueBCVgDI","Element":"SQ","PrimaryAttribute":"QID1137","SecondaryAttribute":"INFORMATION SHEET FOR EXEMPT RESEARCH STUDY TITLE: Consumers and Artificial Intelligence PRINCIPA...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">INFORMATION SHEET FOR EXEMPT RESEARCH<\/div>\nSTUDY TITLE: Consumers and Artificial Intelligence<br>\nPRINCIPAL INVESTIGATOR: Stephanie Tully, Ph.D.<br>\n<br>\nYou are invited to participate in a research study. Your participation is voluntary. This document explains information about this study. You should ask questions about anything that is unclear to you.<br>\nPURPOSE The purpose of this study is to understand people\u2019s knowledge of and opinions about artificial intelligence and algorithms. We hope to learn about people\u2019s preferences for algorithms and factors that impact these preferences. You are invited as a possible participant because you are an adult over the age of 18.<br>\nPARTICIPANT INVOLVEMENT In this survey, you will be asked questions about artificial intelligence. The survey will last approximately 10-15 minutes and can be completed from your computer. This study relies on your current knowledge and opinions. No outside research is needed. If you decide to take part, you will be asked to answer questions about your knowledge of artificial intelligence, and to indicate your beliefs and preferences for artificial intelligence in different situations.<br>\nPAYMENT\/COMPENSATION FOR PARTICIPATION For participants in student subject pools receiving credit: Completing this survey will be used towards completing your survey credits. If you prefer not to take this survey, you may complete alternative surveys in order to receive your completion credit, per the subject pool guidelines. For all other participants: This section will be deleted.<br>\nALTERNATIVES TO PARTICIPATION For student subject pool participants: If you are part of the student subject pool, your alternative may be to participate in another study or to write a paper, please contact the Subject Pool Coordinator for further information.<br>\nCONFIDENTIALITY The members of the research team and the University of Southern California Institutional Review Board (IRB) may access the data. The IRB reviews and monitors research studies to protect the rights and welfare of research subjects. No identifying information will be collected. Anonymous data will be used by the research team. Results of the data as well as the anonymous data may be made publicly available for the purposes of research integrity. For Mturk studies only: This study is conducted on Amazon Mechanical Turk and it adheres to Amazon\u2019s MTurk Privacy Policy. To understand the privacy and confidentiality limitations associated with using MTurk, we strongly advise you to familiarize yourself with Amazon\u2019s privacy policies (https:\/\/www.mturk.com\/mturk\/privacynotice).<br>\nINVESTIGATOR CONTACT INFORMATION If you have any questions about this study, please contact Stephanie Tully, Ph.D. at tullyste@marshall.usc.edu.<br>\nIRB CONTACT INFORMATION If you have any questions about your rights as a research participant, please contact the University of Southern California Institutional Review Board at (323) 442-0114 or email irb@usc.edu.<br><br>","DefaultChoices":false,"DataExportTag":"consent_info","QuestionID":"QID1137","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"INFORMATION SHEET FOR EXEMPT RESEARCH STUDY TITLE: Consumers and Artificial Intelligence PRINCIPA...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_bqgf48GueBCVgDI","Element":"SQ","PrimaryAttribute":"QID1138","SecondaryAttribute":"Please do not take a break during the study. Once you click \"next,\" please complete the study in...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag"