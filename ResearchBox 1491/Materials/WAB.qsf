id":"RQ_NlUaV84Noq33Zw9","version":"v2.0.0"}},"SchemaConfig":{"ChoiceMapping":{"1":"enu:\/\/LessThan25000","2":"enu:\/\/25000-49999","3":"enu:\/\/50000-99999","4":"enu:\/\/100000-199999","5":"enu:\/\/MoreThan200000"},"ChoiceMappingType":"Member","ConfigVersion":"1.0.0","Reconfirm":true,"URL":"ses:\/\/CanadaGrossAnnualHouseholdIncome","XMDConnect":true},"Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"RequestResponse","ForceResponseType":"RequestResponse","Type":"None"}},"DataExportTag":"Income","QuestionID":"QID1255"}},{"SurveyID":"SV_bqgf48GueBCVgDI","Element":"SQ","PrimaryAttribute":"QID1326","SecondaryAttribute":"Today, we want you to consider the enchanting and magical world of AI-generated music. In today\u2019s.","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"color:#bdc3c7;\">Today, we want you to consider the enchanting and magical world of AI-generated music. In today\u2019s world, technology inexplicably translates emotions, stories, and personal experiences into melodious songs. This is about appreciating the magic and awe-inducing nature of AI as it weaves personal stories into harmonies and tunes. AI in this context is an artist in its own right, offering wonder and astonishment in creating music tailored to people\u2019s tastes.<\/span><br>\n<br>\n<strong>Given how amazing and magical you think it would be to have AI write a song, how likely would you be to use AI to write a song for a friend's birthday?<\/strong>","DefaultChoices":false,"DataExportTag":"magic","QuestionID":"QID1326","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","LabelPosition":"BELOW"},"QuestionDescription":"Today, we want you to consider the enchanting and magical world of AI-generated music. In today\u2019s...","Choices":{"2":{"Display":"Very unlikely <br> 1"},"3":{"Display":"2"},"5":{"Display":"3"},"6":{"Display":"4"},"12":{"Display":"5"},"13":{"Display":"6"},"14":{"Display":"Very likely <br> 7"}},"ChoiceOrder":["2","3","5","6","12","13","14"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"VariableNaming":{"2":"Very unlikely  1","12":"5","13":"6","14":"Very likely 7"},"GradingData":[],"Language":[],"NextChoiceId":15,"NextAnswerId":6,"RecodeValues":{"2":"1","3":"2","5":"3","6":"4","12":"5","13":"6","14":"7"}}},{"SurveyID":"SV_bqgf48GueBCVgDI","Element":"SQ","PrimaryAttribute":"QID1355","SecondaryAttribute":"In the next pages we will ask you 17 questions about your general knowledge of artificial intelli...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"font-size:16px;\">In the next pages we will ask you 17 questions about your general knowledge of artificial intelligence, algorithms, online behavior, and data privacy. Whether you know the correct responses WILL NOT impact your compensation.<br>\n<br>\n<u>It is very important that you do not look up or google these answers online, as we are trying to assess average understanding and doing so would defeat the purpose of our survey.<\/u><br>\n<br>\nYou do not need to be an expert on these topics. We are interested in people's actual understanding, so please just answer the following questions to best of your knowledge.&nbsp;<br><br>Please try to answer these questions to the best of your knowledge. We need your honest responses to understand people's general knowledge of AI and algorithms. \n\nFor each question, please choose the answer that you believe is the most accurate.<br>\n<br><br><\/span><\/span>","DefaultChoices":false,"DataExportTag":"Q102","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next pages we will ask you 17 questions about your general knowledge of artificial intelli...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID1355"}},{"SurveyID":"SV_bqgf48GueBCVgDI","Element":"SQ","PrimaryAttribute":"QID1359","SecondaryAttribute":"Today, we want you to consider the enchanting and magical world of AI-generated music. In today\u2019s.","TertiaryAttribute":null,"Payload":{"QuestionText":"Today, we want you to consider the enchanting and magical world of AI-generated music. In today\u2019s world, technology inexplicably translates emotions, stories, and personal experiences into melodious songs. This is about appreciating the magic and awe-inducing nature of AI as it weaves personal stories into harmonies and tunes. AI in this context is an artist in its own right, offering wonder and astonishment in creating music tailored to people\u2019s tastes.","DefaultChoices":false,"DataExportTag":"Q54","QuestionID":"QID1359","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline"},"QuestionDescription":"Today, we want you to consider the enchanting and magical world of AI-generated music. In today\u2019s...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":12,"NextAnswerId":6}},{"SurveyID":"SV_bqgf48GueBCVgDI","Element":"SQ","PrimaryAttribute":"QID1360","SecondaryAttribute":"Today, we want you to consider the practical and efficient world of AI-generated music. In today\u2019.","TertiaryAttribute":null,"Payload":{"QuestionText":"Today, we want you to consider the practical and efficient world of AI-generated music. In today\u2019s world, technology efficiently translates emotions, stories, and personal experiences into melodious songs. This is about appreciating the speed, efficiency, and high quality that AI brings to the table. AI in this context is a capable and reliable composing tool, offering precision and consistency  in creating music tailored to people\u2019s tastes.","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline"},"QuestionDescription":"Today, we want you to consider the practical and efficient world of AI-generated music. In today\u2019...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":12,"NextAnswerId":6,"QuestionText_Unsafe":"Today, we invite you to explore the enchanting and magical world of AI-generated music. In today\u2019s world, technology inexplicably translates emotions, stories, and personal experiences into melodious songs. This is about appreciating the magic and awe-inducing nature of AI as it weaves personal stories into harmonies and tunes. AI in this context is an artist in its own right, offering wonder and astonishment in creating music tailored to people\u2019s tastes.","DataExportTag":"Q1360","QuestionID":"QID1360"}},{"SurveyID":"SV_bqgf48GueBCVgDI","Element":"SQ","PrimaryAttribute":"QID1361","SecondaryAttribute":"Today, we want you to consider the practical and efficient world of AI-generated music. In today\u2019.","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"color:#bdc3c7;\">Today, we want you to consider the practical and efficient world of AI-generated music. In today\u2019s world, technology efficiently translates emotions, stories, and personal experiences into melodious songs. This is about appreciating the speed, efficiency, and high quality that AI brings to the table. AI in this context is a capable and reliable composing tool, offering precision and consistency in creating music tailored to people\u2019s tastes.<\/span><br>\n<br>\n<b id=\"docs-internal-guid-d9ade058-7fff-4bab-a3b5-3a8ae3a1c1b2\">Given how capable and efficient you think it would be to have AI write a song, how likely would you be to use AI to write a song for a friend's birthday?<\/b>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","LabelPosition":"BELOW"},"QuestionDescription":"Today, we want you to consider the practical and efficient world of AI-generated music. In today\u2019...","Choices":{"2":{"Display":"Very unlikely <br> 1"},"3":{"Display":"2"},"5":{"Display":"3"},"6":{"Display":"4"},"12":{"Display":"5"},"13":{"Display":"6"},"14":{"Display":"Very likely <br> 7"}},"ChoiceOrder":["2","3","5","6","12","13","14"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"VariableNaming":{"2":"Very unlikely  1","12":"5","13":"6","14":"Very likely 7"},"GradingData":[],"Language":[],"NextChoiceId":15,"NextAnswerId":6,"RecodeValues":{"2":"1","3":"2","5":"3","6":"4","12":"5","13":"6","14":"7"},"QuestionText_Unsafe":"Today, we invite you to explore the enchanting and magical world of AI-generated music. In today&rsquo;s world, technology inexplicably translates emotions, stories, and personal experiences into melodious songs. This is about appreciating the magic and awe-inducing nature of AI as it weaves personal stories into harmonies and tunes. AI in this context is an artist in its own right, offering wonder and astonishment in creating music tailored to people&rsquo;s tastes.<br \/>\n<br \/>\n<strong>Given how amazing and magical you think it would be to have AI write a song, how likely would you be to use AI to write a song for a friend&#39;s birthday?<\/strong>","DataExportTag":"Q1361","QuestionID":"QID1361"}},{"SurveyID":"SV_bqgf48GueBCVgDI","Element":"SQ","PrimaryAttribute":"QID1362","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q31","QuestionID":"QID1362","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"