":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionText_Unsafe":"One of the most storied algorithmic problems in all of computer science is ...","DataExportTag":"4","QuestionID":"QID1073","VariableNaming":{"1":"Counting","2":"Sorting","3":"Multiplication","4":"Division"}}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1080","SecondaryAttribute":"Please try to answer these questions to the best of your knowledge. We need your honest responses...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"font-size:16px;\">Please try to answer these questions to the best of your knowledge. We need your honest responses to understand people's general knowledge of AI and algorithms.&nbsp;<br>\n<br>\n<strong>For each question, please choose the answer that you believe is <u>the most accurate<\/u>.<\/strong><\/span><\/span>","DefaultChoices":false,"DataExportTag":"Q57","QuestionID":"QID1080","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please try to answer these questions to the best of your knowledge. We need your honest responses...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1103","SecondaryAttribute":"What was the purpose of the PCI DSS (payment card industry data security standard)?","TertiaryAttribute":null,"Payload":{"QuestionText":"What was the purpose of the PCI DSS (payment card industry data security standard)?","DefaultChoices":false,"DataExportTag":"5","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What was the purpose of the PCI DSS (payment card industry data security standard)?","Choices":{"1":{"Display":"Regulate financial transactions"},"2":{"Display":"Manage browser cookies"},"3":{"Display":"Standardize credit score data"},"4":{"Display":"Enable websites to accept crypto currencies"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"1","2":"0","3":"0","4":"0"},"GradingData":[{"ChoiceID":"1","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1103"}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1104","SecondaryAttribute":"Which of these is not a best practice when trying to protect your privacy online?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which of these is <u>not<\/u> a best practice when trying to protect your privacy online?","DefaultChoices":false,"DataExportTag":"6","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which of these is not a best practice when trying to protect your privacy online?","Choices":{"1":{"Display":"Using a two-factor authentication to access account and devices"},"2":{"Display":"Storing your passwords in the notes section of your smartphone"},"3":{"Display":"Updating your operating system promptly when an update becomes available"},"4":{"Display":"Using different login information"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"1","3":"0","4":"0"},"GradingData":[{"ChoiceID":"2","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1104"}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1106","SecondaryAttribute":"If using an algorithm, can the results be biased against specific groups of people?","TertiaryAttribute":null,"Payload":{"QuestionText":"If using an algorithm, can the results be biased against specific groups of people?","DefaultChoices":false,"DataExportTag":"7","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If using an algorithm, can the results be biased against specific groups of people?","Choices":{"1":{"Display":"No, unlike humans, algorithms are free of emotions and cannot be wrong"},"2":{"Display":"Yes, but only if you train them on privileged populations"},"3":{"Display":"Yes, but only if you use them with incomplete data"},"4":{"Display":"Yes, even with correct data and training, algorithms can provide biased results"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"0","3":"0","4":"1"},"GradingData":[{"ChoiceID":"4","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1106"}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1109","SecondaryAttribute":"How algorithmic decisions best explained?","TertiaryAttribute":null,"Payload":{"QuestionText":"How algorithmic decisions best explained?","DefaultChoices":false,"DataExportTag":"8","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How algorithmic decisions best explained?","Choices":{"1":{"Display":"Only for very basic and simple algorithms"},"2":{"Display":"They can be explained by sharing the algorithm with everyone"},"3":{"Display":"As complex code, they cannot be explained"},"4":{"Display":"Algorithms can be explained by sharing the contributing factors to decisions"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"0","3":"0","4":"1"},"GradingData":[{"ChoiceID":"4","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1109"}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1112","SecondaryAttribute":"When programming stock investment recommendation algorithms, these algorithms are typically progr...","TertiaryAttribute":null,"Payload":{"QuestionText":"When programming stock investment recommendation algorithms, these algorithms are typically programmed to:","DefaultChoices":false,"DataExportTag":"9","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"When programming stock investment recommendation algorithms, these algorithms are typically progr...","Choices":{"1":{"Display":"Ignore smaller companies"},"2":{"Display":"Give more weight to random fluctuations in the market"},"3":{"Display":"Consistently keep track of investments"},"4":{"Display":"Prefer indices over specific stocks"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"0","3":"1","4":"0"},"GradingData":[{"ChoiceID":"3","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1112"}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1118","SecondaryAttribute":"AI can take images and short sound clips of people and create long, convincing impersonation of t...","TertiaryAttribute":null,"Payload":{"QuestionText":"AI can take images and short sound clips of people and create long, convincing impersonation of these people saying anything. What is this technology called?","DefaultChoices":false,"DataExportTag":"11","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"AI can take images and short sound clips of people and create long, convincing impersonation of t...","Choices":{"1":{"Display":"Deepmind"},"2":{"Display":"Deepfake"},"3":{"Display":"Deeplearn"},"4":{"Display":"Deepvoice"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"1","3":"0","4":"0"},"GradingData":[{"ChoiceID":"2","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1118"}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1137","SecondaryAttribute":"The person in charge of this study is Chiara Longoni, Assistant Professor of Marketing. Chiara Lo...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">\n<p style=\"text-align: left;\"><span style=\"font-family:Lucida Sans Unicode,Lucida Grande,sans-serif;\"><span style=\"font-size:16px;\">The person in charge of this study is Chiara Longoni, Assistant Professor of Marketing. Chiara Longoni can be reached at 595 Commonwealth Ave, Room 619, Boston, MA 02215 or by phone at 617-353-2000. We will refer to this person as the \u201cresearcher\u201d throughout this form. The purpose of this study is to study the psychological processes involved in human judgment and decision making. We are asking you to take part in this study because you are over 18 years of age, are fluent in English, and can use a computer. The Questrom School of Business at Boston University is paying for this research.<br>\n<br>\n<strong>What will happen if I take part in this research study?<\/strong><\/span><\/span>&nbsp;<span style=\"font-family:Lucida Sans Unicode,Lucida Grande,sans-serif;\"><span style=\"font-size:16px;\">If you agree to take part in this study, you may complete tasks on the computer related to human judgment and decision making.<\/span><\/span><br>\n<br>\n<strong><span style=\"font-size:16px;\"><span style=\"font-family:Lucida Sans Unicode,Lucida Grande,sans-serif;\">Sending Study Information to Research Collaborators Outside Boston University.<\/span><\/span><\/strong>&nbsp;<span style=\"font-family:Lucida Sans Unicode,Lucida Grande,sans-serif;\"><span style=\"font-size:16px;\">In compliance with data sharing practices of the Association for Psychological Science and American Psychological Association, we will make deindentified data from any published study available to researchers who request it.<\/span><\/span><\/p>\n<\/div>\n\n<p><span style=\"font-family:Lucida Sans Unicode,Lucida Grande,sans-serif;\"><span style=\"font-size:16px;\"><strong><br><\/strong><\/span><\/span><\/p><p><span style=\"font-family:Lucida Sans Unicode,Lucida Grande,sans-serif;\"><span style=\"font-size:16px;\"><strong>How Will You Keep My Study Records Confidential?<\/strong>&nbsp;We will keep the records of this study confidential by separating any personally identifiable information collected from your responses. We will make every effort to keep your records confidential. However, there are times when federal or state law requires the disclosure of payment records. The results of this research study may be published or used for teaching. We will not include identifiable information in the presentation of these results.<\/span><\/span><\/p>\n\n<p><span style=\"font-family:Lucida Sans Unicode,Lucida Grande,sans-serif;\"><span style=\"font-size:16px;\"><b><br><\/b><\/span><\/span><\/p><p><span style=\"font-family:Lucida Sans Unicode,Lucida Grande,sans-serif;\"><span style=\"font-size:16px;\"><b>Study Participation and Early Withdrawal<\/b>. Taking part in this study is your choice. You are free not to take part or to withdraw at any time for any reason. No matter what you decide, there will be no penalty or loss of benefit to which you are entitled. If you decide to withdraw from this study, the information that you have already provided will be kept confidential. If you are a student, withdrawing from the study will not affect your class standing or your grades at Boston University. You will not be offered or receive any special consideration if you take part in this research study.<\/span><\/span><\/p>\n\n<p><span style=\"font-family:Lucida Sans Unicode,Lucida Grande,sans-serif;\"><span style=\"font-size:16px;\"><strong><br><\/strong><\/span><\/span><\/p><p><span style=\"font-family:Lucida Sans Unicode,Lucida Grande,sans-serif;\"><span style=\"font-size:16px;\"><strong>What are the risks of taking part in this research study?<\/strong> You may get tired during the tasks. You can rest at any time.<br>\n<br>\n<strong>What alternatives are available? <\/strong>You may choose not to take part in this research study.<br>\n<br>\nIf I have any questions or concerns about this research study, whom can I talk to? You can call between 9am and 5pm with any concerns or questions. Please contact Dr. Chiara Longoni, Principal Investigator, at clongoni@bu.edu, 617-353-2000, who can provide you with a copy of this document. If you have questions about your rights as a research subject or want to speak with someone independent of the research team, you may contact the Boston University IRB directly at 617-358-6115.<\/span><\/span><\/p>","DefaultChoices":false,"DataExportTag":"consent_info","QuestionID":"QID1137","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The person in charge of this study is Chiara Longoni, Assistant Professor of Marketing. Chiara Lo...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1140","SecondaryAttribute":"Thank you so much for your participation, we appreciate your time! If there's anything you would...","TertiaryAttribute":null,"Payload":{"QuestionText":"Thank you so much for your participation, we appreciate your time! <br>If there's anything you would like to let us know, please enter it here (optional).","DefaultChoices":false,"DataExportTag":"open","QuestionID":"QID1140","QuestionType":"TE","Selector":"ESTB","Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":576,"InputHeight":138},"QuestionDescription":"Thank you so much for your participation, we appreciate your time! If there's anything you would...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1141","SecondaryAttribute":"You are almost done with this survey. Please answer a few more questions about you.\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:16px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">You are almost done with this survey. Please answer a few more questions about you.&nbsp;<\/span><\/span>","DefaultChoices":false,"DataExportTag":"Q66","QuestionID":"QID1141","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You are almost done with this survey. Please answer a few more questions about you.\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1151","SecondaryAttribute":"According to the Health Insurance Portability and Accountability Act of 1996 (HIPAA), protected h...","TertiaryAttribute":null,"Payload":{"QuestionText":"According to the Health Insurance Portability and Accountability Act of 1996 (HIPAA), protected health information <u>cannot<\/u> be shared with:","DefaultChoices":false,"DataExportTag":"10","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"According to the Health Insurance Portability and Accountability Act of 1996 (HIPAA), protected h...","Choices":{"1":{"Display":"The patient\u2019s employer"},"2":{"Display":"The patient"},"3":{"Display":"Law enforcement"},"4":{"Display":"The patient\u2019s health insurance"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"1","2":"0","3":"0","4":"0"},"GradingData":[{"ChoiceID":"1","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1151"}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1159","SecondaryAttribute":"Google automatically completes the text you type in the search bar...","TertiaryAttribute":null,"Payload":{"QuestionText":"Google automatically completes the text you type in the search bar...","DefaultChoices":false,"DataExportTag":"12","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Google automatically completes the text you type in the search bar...","Choices":{"1":{"Display":"By looking at the most common search terms used by others and your search history"},"2":{"Display":"Based only on your search history"},"3":{"Display":"Based only on what people in your zip code are searching for"},"4":{"Display":"By using your phone camera when you type and reading your lips"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"1","2":"0","3":"0","4":"0"},"GradingData":[{"ChoiceID":"1","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1159"}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1160","SecondaryAttribute":"Algorithms may improve website performance by doing all of the following except for\u2026.","TertiaryAttribute":null,"Payload":{"QuestionText":"Algorithms may improve website performance by doing all of the following <u>except<\/u> for&hellip;.","DefaultChoices":false,"DataExportTag":"13","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Algorithms may improve website performance by doing all of the following except for\u2026.","Choices":{"1":{"Display":"Showing us content that might interest us"},"2":{"Display":"Showing us relevant ads"},"3":{"Display":"Monitoring which content we engage in"},"4":{"Display":"Changing our screen brightness"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"0","3":"0","4":"1"},"GradingData":[{"ChoiceID":"4","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1160"}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1162","SecondaryAttribute":"What information do social media algorithms not typically use when deciding what information to d...","TertiaryAttribute":null,"Payload":{"QuestionText":"What information do social media algorithms <u>not <\/u>typically use when deciding what information to display to a person?","DefaultChoices":false,"DataExportTag":"14","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What information do social media algorithms not typically use when deciding what information to d...","Choices":{"1":{"Display":"Articles people have previously clicked on"},"2":{"Display":"Videos people have previously watched online"},"3":{"Display":"Information people have shared on social media"},"4":{"Display":"What would benefit society"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"0","3":"0","4":"1"},"GradingData":[{"ChoiceID":"4","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1162"}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1163","SecondaryAttribute":"When you use a web-based service which stores its data in \"the cloud\", where is the data actually...","TertiaryAttribute":null,"Payload":{"QuestionText":"When you use a web-based service which stores its data in \"the cloud\", where is the data actually stored?","DefaultChoices":false,"DataExportTag":"15","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"When you use a web-based service which stores its data in \"the cloud\", where is the data actually...","Choices":{"1":{"Display":"In a hidden folder in your computer"},"2":{"Display":"At the company's headquarters"},"3":{"Display":"At a large server farm"},"4":{"Display":"In your browser's cookies"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"0","3":"1","4":"0"},"GradingData":[{"ChoiceID":"3","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1163"}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1165","SecondaryAttribute":"If you turn off personalized ads, you are most likely to see ads...","TertiaryAttribute":null,"Payload":{"QuestionText":"If you turn <u>off <\/u>personalized ads, you are most likely to see ads...","DefaultChoices":false,"DataExportTag":"16","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If you turn off personalized ads, you are most likely to see ads...","Choices":{"1":{"Display":"Targeting people similar to you"},"2":{"Display":"That are relevant for you"},"3":{"Display":"That are interesting to you"},"4":{"Display":"For commonly purchased products"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"0","3":"0","4":"1"},"GradingData":[{"ChoiceID":"4","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1165"}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1166","SecondaryAttribute":"Pattern recognition is a decision-making step employed by...","TertiaryAttribute":null,"Payload":{"QuestionText":"Pattern recognition is a decision-making step employed by...","DefaultChoices":false,"DataExportTag":"17","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Pattern recognition is a decision-making step employed by...","Choices":{"1":{"Display":"Algorithms"},"2":{"Display":"Humans"},"3":{"Display":"Both"},"4":{"Display":"Neither"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"0","3":"1","4":"0"},"GradingData":[{"ChoiceID":"3","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1166"}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1168","SecondaryAttribute":"When do algorithms tend to perform better than humans?","TertiaryAttribute":null,"Payload":{"QuestionText":"When do algorithms tend to perform better than humans?","DefaultChoices":false,"DataExportTag":"18","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"When do algorithms tend to perform better than humans?","Choices":{"1":{"Display":"When lots of structured data is involved and the risk from a wrong answer is minimal"},"2":{"Display":"When there is no structured data available and the risk from a wrong answer is minimal"},"3":{"Display":"When lots of structured data is involved and the risk from a wrong answer is significant"},"4":{"Display":"When there is no structured data available and risk from a wrong answer is significant"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"1","2":"0","3":"0","4":"0"},"GradingData":[{"ChoiceID":"1","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1168"}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1170","SecondaryAttribute":"What is training data and why is it important?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is training data and why is it important?","DefaultChoices":false,"DataExportTag":"19","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is training data and why is it important?","Choices":{"2":{"Display":"Training data is used to calibrate the model during creation, creating a model that performs best according to that data"},"3":{"Display":"Training data is used to test the model after it was created, to see how it works with new data"},"5":{"Display":"Training data is used when the model is fully calibrated, to train new users with how to work with the model"},"6":{"Display":"Training data is used to minimize bias in older models and train them to new population types"}},"ChoiceOrder":["5","2","3","6"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"2":"1","3":"0","5":"0","6":"0"},"GradingData":[{"ChoiceID":"2","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID1170"}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1171","SecondaryAttribute":"Indicate if the following is primarily the result of an algorithm or not: What I write in a post...","TertiaryAttribute":null,"Payload":{"QuestionText":"Indicate if the following is <u>primarily<\/u> the result of an al