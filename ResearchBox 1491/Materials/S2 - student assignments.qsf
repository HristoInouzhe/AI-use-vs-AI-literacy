 need to be an expert on these topics. We are interested in people's actual understanding, so please just answer the following questions to best of your knowledge.<br>\n<br>\nAnswering correctly\/incorrectly will <u>not<\/u> impact your compensation.<\/span><\/span>","DefaultChoices":false,"DataExportTag":"Q40","QuestionID":"QID1029","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next pages we will ask you 25 questions about your general knowledge of artificial intelli...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","PrimaryAttribute":"QID1059","SecondaryAttribute":"Which of the languages below are used to code a robot?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which of the languages below are used to code a robot?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which of the languages below are used to code a robot?","Choices":{"1":{"Display":"Python"},"2":{"Display":"HTML"},"3":{"Display":"Computer Vision"},"4":{"Display":"Hypertext"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"1","2":"0","3":"0","4":"0"},"GradingData":[{"ChoiceID":"1","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"QuestionText_Unsafe":"Which of the languages below are used to code a robot?","DataExportTag":"1","QuestionID":"QID1059","VariableNaming":{"1":"Python","2":"Html","3":"Computer Vision","4":"Hypertext"}}},{"SurveyID":"SV_5pVYRI4783vYeAC","Element":"SQ","Pri