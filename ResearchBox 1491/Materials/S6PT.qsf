uestionText":"<span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"font-size:16px;\">Please try to answer these questions to the best of your knowledge. We need your honest responses to understand people's general knowledge of AI and algorithms.&nbsp;<br>\n<br>\n<strong>For each question, please choose the answer that you believe is <u>the most accurate<\/u>.<\/strong><\/span><\/span>","DefaultChoices":false,"DataExportTag":"Q57","QuestionID":"QID1080","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please try to answer these questions to the best of your knowledge. We need your honest responses...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_0enwwFyl7tk9fiS","Element":"SQ","PrimaryAttribute":"QID1103","SecondaryAttribute":"What was the purpose of the PCI DSS (payment card industry data security standard)?","TertiaryAttribute":null,"Payload":{"QuestionText":"What was the purpose of the PCI DSS (payment card industry data security standard)?","DefaultChoices":false,"DataExportTag":"5","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What was the purpose of the PCI DSS (payment card industry data security standard)?","Choices":{"1":{"Display":"Regulate financial transactions"},"2":{"Display":"Manage browser cookies"},"3":{"Display":"Standardize credit score data"},"4":{"Display":"Enable websites to accept crypto currencies"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"1","2":"0","3":"0","4":"0"},"GradingData":[{"ChoiceID":"1","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1103"}},{"SurveyID":"SV_0enwwFyl7tk9fiS","Element":"SQ","PrimaryAttribute":"QID1104","SecondaryAttribute":"Which of these is not a best practice when trying to protect your privacy online?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which of these is <u>not<\/u> a best practice when trying to protect your privacy online?","DefaultChoices":false,"DataExportTag":"6","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which of these is not a best practice when trying to protect your privacy online?","Choices":{"1":{"Display":"Using a two-factor authentication to access account and devices"},"2":{"Display":"Storing your passwords in the notes section of your smartphone"},"3":{"Display":"Updating your operating system promptly when an update becomes available"},"4":{"Display":"Using different login information"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"1","3":"0","4":"0"},"GradingData":[{"ChoiceID":"2","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1104"}},{"SurveyID":"SV_0enwwFyl7tk9fiS","Element":"SQ","PrimaryAttribute":"QID1106","SecondaryAttribute":"If using an algorithm, can the results be biased against specific groups of people?","TertiaryAttribute":null,"Payload":{"QuestionText":"If using an algorithm, can the results be biased against specific groups of people?","DefaultChoices":false,"DataExportTag":"7","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If using an algorithm, can the results be biased against specific groups of people?","Choices":{"1":{"Display":"No, unlike humans, algorithms are free of emotions and cannot be wrong"},"2":{"Display":"Yes, but only if you train them on privileged populations"},"3":{"Display":"Yes, but only if you use them with incomplete data"},"4":{"Display":"Yes, even with correct data and training, algorithms can provide biased results"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"0","3":"0","4":"1"},"GradingData":[{"ChoiceID":"4","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1106"}},{"SurveyID":"SV_0enwwFyl7tk9fiS","Element":"SQ","PrimaryAttribute":"QID1109","SecondaryAttribute":"How are algorithmic decisions best explained?","TertiaryAttribute":null,"Payload":{"QuestionText":"How are algorithmic decisions best explained?","DefaultChoices":false,"DataExportTag":"8","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How are algorithmic decisions best explained?","Choices":{"1":{"Display":"Only for very basic and simple algorithms"},"2":{"Display":"They can be explained by sharing the algorithm with everyone"},"3":{"Display":"As complex code, they cannot be explained"},"4":{"Display":"Algorithms can be explained by sharing the contributing factors to decisions"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"0","3":"0","4":"1"},"GradingData":[{"ChoiceID":"4","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1109"}},{"SurveyID":"SV_0enwwFyl7tk9fiS","Element":"SQ","PrimaryAttribute":"QID1112","SecondaryAttribute":"When programming stock investment recommendation algorithms, these algorithms are typically progr...","TertiaryAttribute":null,"Payload":{"QuestionText":"When programming stock investment recommendation algorithms, these algorithms are typically programmed to:","DefaultChoices":false,"DataExportTag":"9","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"When programming stock investment recommendation algorithms, these algorithms are typically progr...","Choices":{"1":{"Display":"Ignore smaller companies"},"2":{"Display":"Give more weight to random fluctuations in the market"},"3":{"Display":"Consistently keep track of investments"},"4":{"Display":"Prefer indices over specific stocks"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"0","3":"1","4":"0"},"GradingData":[{"ChoiceID":"3","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1112"}},{"SurveyID":"SV_0enwwFyl7tk9fiS","Element":"SQ","PrimaryAttribute":"QID1118","SecondaryAttribute":"AI can take images and short sound clips of people and create long, convincing impersonation of t...","TertiaryAttribute":null,"Payload":{"QuestionText":"AI can take images and short sound clips of people and create long, convincing impersonation of these people saying anything. What is this technology called?","DefaultChoices":false,"DataExportTag":"11","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"AI can take images and short sound clips of people and create long, convincing impersonation of t...","Choices":{"1":{"Display":"Deepmind"},"2":{"Display":"Deepfake"},"3":{"Display":"Deeplearn"},"4":{"Display":"Deepvoice"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"1","3":"0","4":"0"},"GradingData":[{"ChoiceID":"2","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1118"}},{"SurveyID":"SV_0enwwFyl7tk9fiS","Element":"SQ","PrimaryAttribute":"QID1137","SecondaryAttribute":"INFORMATION SHEET FOR EXEMPT RESEARCH STUDY TITLE: Consumers and Artificial Intelligence PRINCIPA...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">INFORMATION SHEET FOR EXEMPT RESEARCH<\/div>\nSTUDY TITLE: Consumers and Artificial Intelligence<br>\nPRINCIPAL INVESTIGATOR: Stephanie Tully, Ph.D.<br>\n<br>\nYou are invited to participate in a research study. Your participation is voluntary. This document explains information about this study. You should ask questions about anything that is unclear to you.<br>\nPURPOSE The purpose of this study is to understand people\u2019s knowledge of and opinions about artificial intelligence and algorithms. We hope to learn about people\u2019s preferences for algorithms and factors that impact these preferences. You are invited as a possible participant because you are an adult over the age of 18.<br>\nPARTICIPANT INVOLVEMENT In this survey, you will be asked questions about artificial intelligence. The survey will last approximately 5-10 minutes and can be completed from your computer. This study relies on your current knowledge and opinions. No outside research is needed. If you decide to take part, you will be asked to answer questions about your knowledge of artificial intelligence, and to indicate your beliefs and preferences for artificial intelligence in different situations.<br>\nPAYMENT\/COMPENSATION FOR PARTICIPATION For participants in student subject pools receiving credit: Completing this survey will be used towards completing your survey credits. If you prefer not to take this survey, you may complete alternative surveys in order to receive your completion credit, per the subject pool guidelines. For all other participants: This section will be deleted.<br>\nALTERNATIVES TO PARTICIPATION For student subject pool participants: If you are part of the student subject pool, your alternative may be to participate in another study or to write a paper, please contact the Subject Pool Coordinator for further information.<br>\nCONFIDENTIALITY The members of the research team and the University of Southern California Institutional Review Board (IRB) may access the data. The IRB reviews and monitors research studies to protect the rights and welfare of research subjects. No identifying information will be collected. Anonymous data will be used by the research team. Results of the data as well as the anonymous data may be made publicly available for the purposes of research integrity. For Mturk studies only: This study is conducted on Amazon Mechanical Turk and it adheres to Amazon\u2019s MTurk Privacy Policy. To understand the privacy and confidentiality limitations associated with using MTurk, we strongly advise you to familiarize yourself with Amazon\u2019s privacy policies (https:\/\/www.mturk.com\/mturk\/privacynotice).<br>\nINVESTIGATOR CONTACT INFORMATION If you have any questions about this study, please contact Stephanie Tully, Ph.D. at tullyste@marshall.usc.edu.<br>\nIRB CONTACT INFORMATION If you have any questions about your rights as a research participant, please contact the University of Southern California Institutional Review Board at (323) 442-0114 or email irb@usc.edu.<br><br>","DefaultChoices":false,"DataExportTag":"consent_info","QuestionID":"QID1137","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"INFORMATION SHEET FOR EXEMPT RESEARCH STUDY TITLE: Consumers and Artificial Intelligence PRINCIPA...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_0enwwFyl7tk9fiS","Element":"SQ","PrimaryAttribute":"QID1138","SecondaryAttribute":"Please do not take a break during the study. Once you click \"next,\" please complete the study in...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"inst1","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"Please do not take a break during the study. Once you click \"next,\" please complete the study in...","QuestionID":"QID1138","QuestionText":"<div>Please do not take a break during the study. Once you click \"next,\" please complete the study in once sitting.<\/div>","QuestionText_Unsafe":"<div>Please do not take a break during the study. Once you click \"next,\" please complete the study in once sitting.<\/div>","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_0enwwFyl7tk9fiS","Element":"SQ","PrimaryAttribute":"QID1140","SecondaryAttribute":"Thank you so much for your participation, we appreciate your time! If there's anything you would...","TertiaryAttribute":null,"Payload":{"QuestionText":"Thank you so much for your participation, we appreciate your time! <br>If there's anything you would like to let us know, please enter it here (optional).","DefaultChoices":false,"DataExportTag":"open","QuestionID":"QID1140","QuestionType":"TE","Selector":"ESTB","Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":576,"InputHeigh