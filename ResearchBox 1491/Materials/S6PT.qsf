The patient"},"3":{"Display":"Law enforcement"},"4":{"Display":"The patient\u2019s health insurance"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"1","2":"0","3":"0","4":"0"},"GradingData":[{"ChoiceID":"1","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1151"}},{"SurveyID":"SV_0enwwFyl7tk9fiS","Element":"SQ","PrimaryAttribute":"QID1159","SecondaryAttribute":"Google automatically completes the text you type in the search bar...","TertiaryAttribute":null,"Payload":{"QuestionText":"Google automatically completes the text you type in the search bar...","DefaultChoices":false,"DataExportTag":"12","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Google automatically completes the text you type in the search bar...","Choices":{"1":{"Display":"By looking at the most common search terms used by others and your search history"},"2":{"Display":"Based only on your search history"},"3":{"Display":"Based only on what people in your zip code are searching for"},"4":{"Display":"By using your phone camera when you type and reading your lips"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"1","2":"0","3":"0","4":"0"},"GradingData":[{"ChoiceID":"1","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1159"}},{"SurveyID":"SV_0enwwFyl7tk9fiS","Element":"SQ","PrimaryAttribute":"QID1160","SecondaryAttribute":"Algorithms may improve website performance by doing all of the following except for\u2026.","TertiaryAttribute":null,"Payload":{"QuestionText":"Algorithms may improve website performance by doing all of the following <u>except<\/u> for&hellip;.","DefaultChoices":false,"DataExportTag":"13","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Algorithms may improve website performance by doing all of the following except for\u2026.","Choices":{"1":{"Display":"Showing us content that might interest us"},"2":{"Display":"Showing us relevant ads"},"3":{"Display":"Monitoring which content we engage in"},"4":{"Display":"Changing our screen brightness"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"0","3":"0","4":"1"},"GradingData":[{"ChoiceID":"4","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1160"}},{"SurveyID":"SV_0enwwFyl7tk9fiS","Element":"SQ","PrimaryAttribute":"QID1162","SecondaryAttribute":"What information do social media algorithms not typically use when deciding what information to d...","TertiaryAttribute":null,"Payload":{"QuestionText":"What information do social media algorithms <u>not <\/u>typically use when deciding what information to display to a person?","DefaultChoices":false,"DataExportTag":"14","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What information do social media algorithms not typically use when deciding what information to d...","Choices":{"1":{"Display":"Articles people have previously clicked on"},"2":{"Display":"Videos people have previously watched online"},"3":{"Display":"Information people have shared on social media"},"4":{"Display":"What would benefit society"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"0","3":"0","4":"1"},"GradingData":[{"ChoiceID":"4","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1162"}},{"SurveyID":"SV_0enwwFyl7tk9fiS","Element":"SQ","PrimaryAttribute":"QID1163","SecondaryAttribute":"When you use a web-based service which stores its data in \"the cloud\", where is the data actually...","TertiaryAttribute":null,"Payload":{"QuestionText":"When you use a web-based service which stores its data in \"the cloud\", where is the data actually stored?","DefaultChoices":false,"DataExportTag":"15","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"When you use a web-based service which stores its data in \"the cloud\", where is the data actually...","Choices":{"1":{"Display":"In a hidden folder in your computer"},"2":{"Display":"At the company's headquarters"},"3":{"Display":"At a large server farm"},"4":{"Display":"In your browser's cookies"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"0","3":"1","4":"0"},"GradingData":[{"ChoiceID":"3","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1163"}},{"SurveyID":"SV_0enwwFyl7tk9fiS","Element":"SQ","PrimaryAttribute":"QID1165","SecondaryAttribute":"If you turn off personalized ads, you are most likely to see ads...","TertiaryAttribute":null,"Payload":{"QuestionText":"If you turn <u>off <\/u>personalized ads, you are most likely to see ads...","DefaultChoices":false,"DataExportTag":"16","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If you turn off personalized ads, you are most likely to see ads...","Choices":{"1":{"Display":"Targeting people similar to you"},"2":{"Display":"That are relevant for you"},"3":{"Display":"That are interesting to you"},"4":{"Display":"For commonly purchased products"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"0","3":"0","4":"1"},"GradingData":[{"ChoiceID":"4","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1165"}},{"SurveyID":"SV_0enwwFyl7tk9fiS","Element":"SQ","PrimaryAttribute":"QID1166","SecondaryAttribute":"Pattern recognition is a decision-making step employed by...","TertiaryAttribute":null,"Payload":{"QuestionText":"Pattern recognition is a decision-making step employed by...","DefaultChoices":false,"DataExportTag":"17","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Pattern recognition is a decision-making step employed by...","Choices":{"1":{"Display":"Algorithms"},"2":{"Display":"Humans"},"3":{"Display":"Both"},"4":{"Display":"Neither"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"0","3":"1","4":"0"},"GradingData":[{"ChoiceID":"3","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1166"}},{"SurveyID":"SV_0enwwFyl7tk9fiS","Element":"SQ","PrimaryAttribute":"QID1168","SecondaryAttribute":"When do algorithms tend to perform better than humans?","TertiaryAttribute":null,"Payload":{"QuestionText":"When do algorithms tend to perform better than humans?","DefaultChoices":false,"DataExportTag":"18","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"When do algorithms tend to perform better than humans?","Choices":{"1":{"Display":"When lots of structured data is involved and the risk from a wrong answer is minimal"},"2":{"Display":"When there is no structured data available and the risk from a wrong answer is minimal"},"3":{"Display":"When lots of structured data is involved and the risk from a wrong answer is significant"},"4":{"Display":"When there is no structured data available and risk from a wrong answer is significant"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"1","2":"0","3":"0","4":"0"},"GradingData":[{"ChoiceID":"1","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1168"}},{"SurveyID":"SV_0enwwFyl7tk9fiS","Element":"SQ","PrimaryAttribute":"QID1170","SecondaryAttribute":"What is training data and why is it important?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is training data and why is it important?","DefaultChoices":false,"DataExportTag":"19","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is training data and why is it important?","Choices":{"2":{"Display":"Training data is used to calibrate the model during creation, creating a model that performs best according to that data"},"3":{"Display":"Training data is used to test the model after it was created, to see how it works with new data"},"5":{"Display":"Training data is used when the model is fully calibrated, to train new users with how to work with the model"},"6":{"Display":"Training data is used to minimize bias in older models and train them to new population types"}},"ChoiceOrder":["5","2","3","6"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"2":"1","3":"0","5":"0","6":"0"},"GradingData":[{"ChoiceID":"2","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID1170"}},{"SurveyID":"SV_0enwwFyl7tk9fiS","Element":"SQ","PrimaryAttribute":"QID1171","SecondaryAttribute":"Indicate if the following is primarily the result of an algorithm or not: What I write in a post...","TertiaryAttribute":null,"Payload":{"QuestionText":"Indicate if the following is <u>primarily<\/u> the result of an algorithm or not:<br \/>\n<br \/>\nWhat I write in a post on social media","DefaultChoices":false,"DataExportTag":"20","QuestionID":"QID1171","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","LabelPosition":"BELOW"},"QuestionDescription":"Indicate if the following is primarily the result of an algorithm or not: What I write in a post...","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"VariableNaming":[],"GradingData":[{"ChoiceID":"2","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":4,"NextAnswerId":4,"RecodeValues":{"1":"0","2":"1"},"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_0enwwFyl7tk9fiS","Element":"SQ","PrimaryAttribute":"QID1173","SecondaryAttribute":"Indicate if the following is pr