We need your honest responses to understand people's general knowledge of AI and algorithms.&nbsp;<br>\n<br>\n<strong>For each question, please choose the answer that you believe is <u>the most accurate<\/u>.<\/strong><\/span><\/span>","DefaultChoices":false,"DataExportTag":"Q57","QuestionID":"QID1080","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please try to answer these questions to the best of your knowledge. We need your honest responses...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_eLEzpc3v07E3DzE","Element":"SQ","PrimaryAttribute":"QID1103","SecondaryAttribute":"What was the purpose of the PCI DSS (payment card industry data security standard)?","TertiaryAttribute":null,"Payload":{"QuestionText":"What was the purpose of the PCI DSS (payment card industry data security standard)?","DefaultChoices":false,"DataExportTag":"5","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What was the purpose of the PCI DSS (payment card industry data security standard)?","Choices":{"1":{"Display":"Regulate financial transactions"},"2":{"Display":"Manage browser cookies"},"3":{"Display":"Standardize credit score data"},"4":{"Display":"Enable websites to accept crypto currencies"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"1","2":"0","3":"0","4":"0"},"GradingData":[{"ChoiceID":"1","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1103"}},{"SurveyID":"SV_eLEzpc3v07E3DzE","Element":"SQ","PrimaryAttribute":"QID1104","SecondaryAttribute":"Which of these is not a best practice when trying to protect your privacy online?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which of these is <u>not<\/u> a best practice when trying to protect your privacy online?","DefaultChoices":false,"DataExportTag":"6","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which of these is not a best practice when trying to protect your privacy online?","Choices":{"1":{"Display":"Using a two-factor authentication to access account and devices"},"2":{"Display":"Storing your passwords in the notes section of your smartphone"},"3":{"Display":"Updating your operating system promptly when an update becomes available"},"4":{"Display":"Using different login information"}},"ChoiceOrder":["1","2","3","4"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"0","2":"1","3":"0","4":"0"},"GradingData":[{"ChoiceID":"2","Grades":{"SC_3yiz1h5H6L2hvZY":"1"},"index":0}],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1104"}},{"SurveyID":"SV_eLEzpc3v07E3DzE","Element":"SQ","PrimaryAttribute":"QID1106","SecondaryAttribute":"If using an algorithm, can the results be biased against specific groups of people?","TertiaryAttribute":null,"Payload":{"QuestionText":"If using an algorithm, can the results be biased against specific groups of people?","DefaultChoices":false,"DataExportTag":"7","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If using an algorithm, can the results be biased against specific groups of people?","Choices":{"1":{"Display":"No, unlike humans, algorithms are free of emotions and canno